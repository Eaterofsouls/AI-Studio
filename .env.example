# AI Cinema Studio Engine — Environment Configuration
# Copy this file to .env and configure your keys:
#   cp .env.example .env

APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./cinema_studio.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cinema_studio

# Video & Image Generation (fal.ai gateway)
FAL_KEY=your-fal-key-here

# Video & Image Alternative Gateway (Replicate)
REPLICATE_API_TOKEN=your-replicate-token-here

# Cinematography RAG & Embeddings (OpenAI + Qdrant)
OPENAI_API_KEY=your-openai-key-here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Audio & Voiceover Synthesis (ElevenLabs)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Production Lip-Sync (Sync Labs)
SYNCLABS_API_KEY=your-synclabs-key-here

# Temporal Orchestration
TEMPORAL_HOST=localhost:7233
